# Scenes and asset metadata are compared byte for byte across platforms.
*.bsn text eol=lf
*.jsn text eol=lf
*.meta text eol=lf
# Generated by `cargo xtask bsn-parser`, which compares it byte for byte.
crates/jackdaw_bsn/src/parse/grammar.rs text eol=lf linguist-generated=true
# Signed extension fixtures are compared byte for byte.
crates/jackdaw_package/tests/fixtures/* -text
