// jackdaw asset jackdaw_editor_core::recipes::Recipe
#stairs
jackdaw_editor_core::recipes::Recipe {
    description: "A straight flight of solid steps climbing along +z.",
    inputs: [
        jackdaw_editor_core::recipes::RecipeInput { name: "steps", kind: "int", default: "6", range: [2.0, 64.0] },
        jackdaw_editor_core::recipes::RecipeInput { name: "width", kind: "float", default: "1.2", range: [0.3, 10.0] },
        jackdaw_editor_core::recipes::RecipeInput { name: "rise", kind: "float", default: "0.2", range: [0.05, 1.0] },
        jackdaw_editor_core::recipes::RecipeInput { name: "run", kind: "float", default: "0.3", range: [0.1, 2.0] },
        jackdaw_editor_core::recipes::RecipeInput { name: "material", kind: "text", default: "", range: [] },
    ],
    calls: [
        jackdaw_editor_core::recipes::RecipeCall { id: "entity.add.cube", params: map[
            ("name", "Step"),
            ("size", "[$width, $rise, $run]"),
            ("pos", "[0, $rise * 0.5, $run * 0.5]"),
            ("material", "$material"),
        ] },
        jackdaw_editor_core::recipes::RecipeCall { id: "entity.tag", params: map[
            ("entities", "$0.entities.0"),
            ("add", "step"),
        ] },
        jackdaw_editor_core::recipes::RecipeCall { id: "entity.duplicate", params: map[
            ("entity", "$0.entities.0"),
            ("count", "$steps - 1"),
            ("offset", "[0, $rise, $run]"),
        ] },
    ],
}
