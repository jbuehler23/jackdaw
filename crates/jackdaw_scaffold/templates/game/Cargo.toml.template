[package]
name = "{{project-name}}"
version = "0.1.0"
edition = "2024"
authors = ["{{authors}}"]

# jackdaw builds its editor artifacts in .jackdaw/ and edits this manifest
# only when you change the project's modules; `cargo run` works with or
# without the editor installed.

# Keeps this project out of any cargo workspace it was created inside.
# Delete to join the surrounding workspace instead; its profiles must then move
# to that workspace's root.
[workspace]

# Bevy and the runtime compile optimised so scenes load and run at a usable
# speed; your own crate stays unoptimised so it rebuilds quickly. This costs a
# few extra minutes on the very first build.
[profile.dev.package."*"]
opt-level = 2
debug = "line-tables-only"

[dependencies]
{{bevy_pin_note}}
bevy = {{bevy_dependency}}
# Loads authored scenes (assets/*.bsn). `terrain` and `tilemap` draw authored
# terrain and tilemaps, and `pie` connects the editor's Play button; drop
# `pie` for a shipping build.
# The other features and crates come from the modules in jackdaw.toml.
jackdaw_runtime = { {{jackdaw_runtime_dep}}, features = [{{jackdaw_runtime_features}}] }
{{module_crates}}
