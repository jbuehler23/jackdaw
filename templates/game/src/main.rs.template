//! Entry point for {{project-name}}.
//!
//! This is an ordinary Bevy binary. `cargo run` plays the game, and the
//! editor's Play button builds and runs this exact executable, so what
//! you test in the editor is what you ship. The editor talks to it over
//! an IPC link it sets up in the environment; nothing here is linked
//! against the editor.

use bevy::image::{ImageAddressMode, ImagePlugin, ImageSamplerDescriptor};
use bevy::prelude::*;

fn main() -> AppExit {
    // A `Repeat` sampler so the tileable materials authored in the
    // editor render the same way at runtime; Bevy's default
    // `ClampToEdge` smears texture edges on brush geometry.
    let default_plugins = DefaultPlugins.set(ImagePlugin {
        default_sampler: ImageSamplerDescriptor {
            address_mode_u: ImageAddressMode::Repeat,
            address_mode_v: ImageAddressMode::Repeat,
            address_mode_w: ImageAddressMode::Repeat,
            ..ImageSamplerDescriptor::linear()
        },
    });

    // When the editor plays the game inside its viewport it asks for a
    // windowless launch, and this swaps winit for a schedule runner that
    // renders into the streamed image. Outside the editor it returns the
    // plugin group untouched.
    let default_plugins = jackdaw_runtime::maybe_windowless(default_plugins);

    App::new()
        .add_plugins(default_plugins)
        .add_plugins(avian3d::prelude::PhysicsPlugins::default())
        .add_plugins(jackdaw_runtime::JackdawPlugin)
        .add_plugins({{crate_name}}::GamePlugin)
        .run()
}
