[package]
name = "{{project-name}}"
version = "0.1.0"
edition = "2024"
authors = ["{{authors}}"]

# jackdaw builds its editor artifacts in .jackdaw/ and never edits this
# manifest; `cargo run` works with or without the editor installed.

# Keeps this project out of any cargo workspace it was created inside.
# Delete to join the surrounding workspace instead.
[workspace]

[dependencies]
bevy = "{{bevy_version}}"
# Loads authored scenes (assets/*.bsn). `physics` builds colliders from
# authored brushes and terrain, `terrain` draws authored terrain, `pie`
# connects the editor's Play button; drop `pie` for a shipping build.
jackdaw_runtime = { {{jackdaw_runtime_dep}}, features = ["physics", "terrain", "pie"] }
avian3d = "0.7"
