[package]
name = "{{project-name}}"
version = "0.1.0"
edition = "2024"
authors = ["{{authors}}"]
# `jd extension pack` reads publisher, license and homepage from here.
license = "MIT OR Apache-2.0"

# An editor extension is a Bevy library built on jackdaw_extension.
# jackdaw builds it in .jackdaw/ against the editor's SDK; `cargo check`
# works standalone.

# Keeps this project out of any cargo workspace it was created inside.
# Delete to join the surrounding workspace instead.
[workspace]

[package.metadata.jackdaw]
# Display name in the editor's extension list. Defaults to the package name.
label = "{{project-name | title_case}}"

[dependencies]
bevy = "{{bevy_version}}"
jackdaw_extension = { {{jackdaw_extension_dep}} }
