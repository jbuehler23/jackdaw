//! {{project-name}}: a jackdaw editor extension.
//!
//! Open this folder in jackdaw and the extension loads into the
//! running editor; rebuilds hot-reload it. The `jackdaw` repository's
//! `examples/extension/` directory shows the full API surface:
//! operators, menu entries, panels, windows, and keybindings.

use bevy::prelude::*;
use jackdaw_api::prelude::*;

/// The extension type. The editor finds it by name (override with
/// `plugin = "..."` in jackdaw.toml) and calls [`JackdawExtension::register`]
/// when it loads.
#[derive(Default)]
pub struct MyExtension;

impl JackdawExtension for MyExtension {
    fn id(&self) -> String {
        "{{project-name}}".to_string()
    }

    fn label(&self) -> String {
        "{{project-name | title_case}}".to_string()
    }

    fn description(&self) -> String {
        "Describe what your extension adds to the editor.".to_string()
    }

    fn register(&self, _ctx: &mut ExtensionContext) {
        info!("{{project-name}} registered");
    }
}
